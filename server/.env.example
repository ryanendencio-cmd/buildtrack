# Copy this file to .env and configure an SMTP mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-mailbox-app-password
SMTP_FROM=your-sender@gmail.com

# Local Laragon MySQL settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=buildtrack_db

# Optional Firestore mirror and migration credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
