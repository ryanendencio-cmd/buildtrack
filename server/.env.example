# Copy this file to .env, then set the credentials for your local services.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-mailbox-app-password
SMTP_FROM=your-sender@gmail.com

# Defaults to MySQL outside production and Firebase in production.
DB_TYPE=mysql

# MySQL credentials (use the password configured for this MySQL user).
# Leave DB_PASSWORD empty only if this user has no password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=buildtrack_db

# Production requires a stable, random JWT secret of at least 32 bytes.
# RFID_API_KEY is required for hardware attendance scans; configure the same key on the terminal.
JWT_SECRET=
RFID_API_KEY=

# Optional Firestore mirror credentials for local MySQL.
# In production, set DB_TYPE=firebase and provide Firebase credentials on the backend.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set FIREBASE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS.
