# Web app API base URL
# Set this to your backend URL for local or production hosting.
# Examples:
# VITE_API_URL=http://localhost:5000/api
# VITE_API_URL=http://192.168.0.27:5000/api
# VITE_API_URL=https://your-live-backend-domain.com/api

VITE_API_URL=http://localhost:5000/api

# Server-side Firebase / Firestore configuration
# Add these in server/.env
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# USE_FIRESTORE=true
